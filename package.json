{
  "name": "kvizhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kvizhub/server --filter @kvizhub/web dev",
    "build": "pnpm --filter @kvizhub/web build && pnpm --filter @kvizhub/server build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc -p packages/core && tsc -p packages/export && tsc -p apps/server && tsc -p apps/web && tsc -p scripts",
    "lint": "eslint .",
    "check:contrast": "tsx scripts/contrast.ts",
    "check:fonts": "python3 scripts/check-fonts.py 'Baloo 2=apps/web/public/fonts/baloo2-latin.woff2,apps/web/public/fonts/baloo2-latin-ext.woff2' 'Nunito=apps/web/public/fonts/nunito-latin.woff2,apps/web/public/fonts/nunito-latin-ext.woff2' 'Atkinson Hyperlegible 400=apps/web/public/fonts/atkinson-latin-400.woff2,apps/web/public/fonts/atkinson-latin-ext-400.woff2' 'Atkinson Hyperlegible 700=apps/web/public/fonts/atkinson-latin-700.woff2,apps/web/public/fonts/atkinson-latin-ext-700.woff2'",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:skill": "cd agent-skill/kviz-z-materialu && (test -x .venv/bin/python && .venv/bin/python -m pytest -q || python3 -m pytest -q)",
    "loadtest": "tsx scripts/loadtest.ts",
    "demo": "tsx scripts/demo.ts",
    "seed:demo-class": "tsx scripts/seed-demo-class.ts",
    "docs:screens": "tsx scripts/screens.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:contrast && pnpm test",
    "check:budgets": "tsx scripts/budgets.ts",
    "check:lighthouse": "tsx scripts/lighthouse.ts",
    "test:visual": "VISUAL=1 playwright test e2e/visual",
    "brand:build": "node scripts/brand-build.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@kvizhub/core": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "exceljs": "^4.4.0",
    "globals": "^17.12.0",
    "lighthouse": "^13.5.0",
    "sharp": "^0.34.5",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
