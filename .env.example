# Veřejná adresa aplikace (bez lomítka na konci). Za reverzní proxy s HTTPS doporučeně https://lore.zdenekstasta.cz
# (doménu si zvolí provozovatel; používá se i pro náhled odkazů og:image)
PUBLIC_URL=http://localhost:3000
# Tajný klíč pro session a CSRF, min. 32 znaků. Vygenerujte: openssl rand -hex 32
SESSION_SECRET=
# Kontejner naslouchá jen na této adrese a portu (HTTPS řeší reverzní proxy)
BIND_ADDR=127.0.0.1
APP_PORT=3000
GAME_PIN_LENGTH=6
# Mazání výsledků her a hráčů po N dnech (kvízy zůstávají)
RETENTION_DAYS=365
# Volitelný webhook po skončení hry (POST {gameId, quizId, status}), podpis HMAC-SHA256 v hlavičce X-KvizHub-Signature
API_WEBHOOK_URL=
API_WEBHOOK_SECRET=
# Délkové limity exportu do Kahootu (otázka / odpověď)
EXPORT_KAHOOT_MAX_Q=95
EXPORT_KAHOOT_MAX_A=60
# Volitelné:
# ALLOW_REGISTRATION=1        # 0 = registrace nových učitelů vypnuta (po založení vlastního účtu doporučeno)
# AUTH_PROVIDER=local         # local | oidc (oidc zatím jen rozhraní)
# TRUST_PROXY=1               # aplikace běží za reverzní proxy (X-Forwarded-For)
# LOG_LEVEL=info
# SEED_SAMPLE_QUIZ=1         # nový učitel dostane ukázkový kvíz
# Testovací režim: jména žáků se po N dnech nahradí „Žák N“ (výsledky zůstávají do RETENTION_DAYS)
TEST_NAME_RETENTION_DAYS=30
# Hlídání okna v testu: mezera v heartbeatu delší než N s se zapíše jako nepotvrzená nepřítomnost (nepočítá se)
HEARTBEAT_GAP_SEC=25
# ---------- Třídy a evidence (Dodatek 3) ----------
# Tajný klíč pro otisky osobních kódů žáků, min. 32 znaků: openssl rand -hex 32
# Bez něj jsou třídy vypnuté. POZOR: změna CODE_PEPPER zneplatní všechny vytištěné kódy.
CODE_PEPPER=
# Po kolika měsících od konce školního roku (nebo archivace) se osobní údaje třídy anonymizují
CLASS_RETENTION_MONTHS=12
ACCESS_LOG_RETENTION_MONTHS=24
# Téma se ukáže až při aspoň N položkách; souhrny pro agenta až od N žáků/výsledků
MIN_TOPIC_ITEMS=5
MIN_AGGREGATE_STUDENTS=5
MAX_STUDENTS_PER_CLASS=60

# ---- Dodatek 4: vzhled ----
# Název aplikace v rozhraní (výchozí Lore)
APP_NAME=Lore
# Vývojová stránka /_design s tokeny, komponentami a motivy (v produkci vypnuto)
DESIGN_PAGE=0

# Vlastní obrázky pozadí učitelů (Dodatek 4, V8). Soubory WebP se ukládají do MEDIA_DIR
# (výchozí: složka media vedle databáze, v Dockeru /data/media) a zálohuje je scripts/backup.sh.
# THEME_UPLOADS=0 nahrávání vypne; vestavěné motivy fungují dál.
THEME_UPLOADS=1
# MEDIA_DIR=/data/media
