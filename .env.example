# Veřejná adresa aplikace (bez lomítka na konci). Za reverzní proxy s HTTPS např. https://kviz.mojeskola.cz
PUBLIC_URL=http://localhost:3000
# Tajný klíč pro session a CSRF, min. 32 znaků. Vygenerujte: openssl rand -hex 32
SESSION_SECRET=
# Kontejner naslouchá jen na této adrese a portu (HTTPS řeší reverzní proxy)
BIND_ADDR=127.0.0.1
APP_PORT=3000
GAME_PIN_LENGTH=6
# Mazání výsledků her a hráčů po N dnech (kvízy zůstávají)
RETENTION_DAYS=365
# Volitelný webhook po skončení hry (POST {gameId, quizId, status}), podpis HMAC-SHA256 v hlavičce X-KvizHub-Signature
API_WEBHOOK_URL=
API_WEBHOOK_SECRET=
# Délkové limity exportu do Kahootu (otázka / odpověď)
EXPORT_KAHOOT_MAX_Q=95
EXPORT_KAHOOT_MAX_A=60
# Volitelné:
# ALLOW_REGISTRATION=1        # 0 = registrace nových učitelů vypnuta (po založení vlastního účtu doporučeno)
# AUTH_PROVIDER=local         # local | oidc (oidc zatím jen rozhraní)
# TRUST_PROXY=1               # aplikace běží za reverzní proxy (X-Forwarded-For)
# LOG_LEVEL=info
# SEED_SAMPLE_QUIZ=1         # nový učitel dostane ukázkový kvíz
# Testovací režim: jména žáků se po N dnech nahradí „Žák N“ (výsledky zůstávají do RETENTION_DAYS)
TEST_NAME_RETENTION_DAYS=30
# Hlídání okna v testu: mezera v heartbeatu delší než N s se zapíše jako nepotvrzená nepřítomnost (nepočítá se)
HEARTBEAT_GAP_SEC=25
